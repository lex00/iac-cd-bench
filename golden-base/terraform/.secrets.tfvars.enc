# =============================================================================
# SOPS-encrypted secrets template
# =============================================================================
# This file is a template for SOPS-encrypted Terraform variables.
# The actual encrypted file is .secrets.tfvars.enc which is auto-decrypted
# to .secrets.auto.tfvars at plan/apply time via pre-commit or CI.
#
# To encrypt:
#   sops -e --encrypted-regex '^(db_password)$' .secrets.tfvars.enc > .secrets.tfvars.enc.tmp
#   mv .secrets.tfvars.enc.tmp .secrets.tfvars.enc
#
# The auto-decrypted file is gitignored; only the .enc file is committed.
# =============================================================================

db_password = "CHANGE_ME_AFTER_ENCRYPTING"
